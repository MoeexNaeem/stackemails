{
  "name": "nanosend",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the NanoSend email API.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["nanosend", "email", "api", "ses", "transactional"],
  "peerDependencies": {
    "@react-email/render": ">=1.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@react-email/render": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
